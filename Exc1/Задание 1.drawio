        <mxCell id="zXd8N8TstwR9vP42mUY_-33" value="Заменить на Airflow&lt;div&gt;Высокий охват&lt;div&gt;Средняя результативность&lt;/div&gt;&lt;div&gt;Высокая достоверность&lt;/div&gt;&lt;div&gt;Средние усилия&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="zXd8N8TstwR9vP42mUY_-32" vertex="1">
