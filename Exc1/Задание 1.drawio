        <mxCell id="zXd8N8TstwR9vP42mUY_-35" value="Высокий охват 1&lt;br&gt;&lt;div&gt;Средняя результативность&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;0.5&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Средняя достоверность 0.5&lt;/div&gt;&lt;div&gt;Средние усилия 0.5&lt;/div&gt;" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="zXd8N8TstwR9vP42mUY_-32" vertex="1">
