        <mxCell id="4uydy69X5d787QOvp0hG-11" value="&lt;font&gt;T2&lt;/font&gt;&lt;div&gt;Запланированы конкретные проекты в доменах по развитию «витрины данных»&lt;/div&gt;" style="shape=rect;fillColor=#B9E0A5;strokeColor=#d79b00;fontSize=18;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=5;rounded=0;labelPosition=center;verticalLabelPosition=middle;" parent="3D7FDG2aXA9G618_Kong-1" vertex="1">
